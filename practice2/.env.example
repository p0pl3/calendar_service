# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=caluser
POSTGRES_PASSWORD=calpass
POSTGRES_DB=calendar_db

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=rabbituser
RABBITMQ_DEFAULT_PASS=rabbitpass

# ─── JWT (shared across user-service and event-service) ───────────────────────
SECRET_KEY=change_me_to_random_32_byte_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Notification Service ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=Calendar Reminder <your@gmail.com>

# ─── Host ports (change to avoid conflicts with local services) ───────────────
HOST_PORT_POSTGRES=5432
HOST_PORT_REDIS=6379
HOST_PORT_RABBITMQ=5672
HOST_PORT_RABBITMQ_MGT=15672
HOST_PORT_USER_SVC=8001
HOST_PORT_EVENT_SVC=8002
HOST_PORT_NOTIFY_SVC=8003
HOST_PORT_API=80
HOST_PORT_FRONTEND=3000
